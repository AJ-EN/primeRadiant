# The only cost surface. Without it, /api/parse returns no_key and the UI falls back to
# manual entry — the app still works end to end, it just cannot read sentences.
ANTHROPIC_API_KEY=

# Analytics no-ops entirely when this is unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
